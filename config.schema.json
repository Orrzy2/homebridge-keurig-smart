{
  "pluginAlias": "KeurigSmart",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Control a Keurig SMART brewer (K-Supreme SMART, K-Supreme Plus SMART, K-Café SMART) through the Keurig cloud. Use the same email and password you use in the Keurig app. This uses Keurig's unofficial app API and may stop working if Keurig changes it.",
  "footerDisplay": "Brewing needs water in the reservoir, a fresh pod and the lid closed. The Brew switch turns itself off when the brew finishes.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Platform Name",
        "type": "string",
        "default": "Keurig",
        "required": true
      },
      "email": {
        "title": "Keurig app email",
        "type": "string",
        "format": "email",
        "required": true
      },
      "password": {
        "title": "Keurig app password",
        "type": "string",
        "required": true,
        "x-schema-form": { "type": "password" }
      },
      "pollInterval": {
        "title": "Status check interval (seconds)",
        "description": "How often to ask Keurig for the brewer's status. Minimum 30. It checks every 5 seconds while brewing.",
        "type": "integer",
        "default": 60,
        "minimum": 30,
        "maximum": 3600
      },
      "brewMode": {
        "title": "Brew settings",
        "type": "string",
        "default": "recommended",
        "oneOf": [
          { "title": "Recommended for the pod (falls back to custom)", "enum": ["recommended"] },
          { "title": "Custom (temperature and strength below)", "enum": ["custom"] }
        ]
      },
      "brewSize": {
        "title": "Cup size (oz)",
        "type": "integer",
        "default": 8,
        "oneOf": [
          { "title": "4 oz", "enum": [4] },
          { "title": "6 oz", "enum": [6] },
          { "title": "8 oz", "enum": [8] },
          { "title": "10 oz", "enum": [10] },
          { "title": "12 oz", "enum": [12] }
        ]
      },
      "brewTemperature": {
        "title": "Temperature (custom mode)",
        "type": "string",
        "default": "Hot",
        "oneOf": [
          { "title": "Warm (187°F)", "enum": ["Warm"] },
          { "title": "Warmer (191°F)", "enum": ["Warmer"] },
          { "title": "Hot (194°F)", "enum": ["Hot"] },
          { "title": "Hotter (197°F)", "enum": ["Hotter"] },
          { "title": "Extra Hot (200°F)", "enum": ["XHot"] },
          { "title": "Max Hot (204°F)", "enum": ["MaxHot"] }
        ]
      },
      "brewIntensity": {
        "title": "Strength (custom mode)",
        "type": "string",
        "default": "Balanced",
        "oneOf": [
          { "title": "Balanced", "enum": ["Balanced"] },
          { "title": "Rich", "enum": ["Rich"] },
          { "title": "Robust", "enum": ["Robust"] },
          { "title": "Strong", "enum": ["Strong"] },
          { "title": "Intense", "enum": ["Intense"] }
        ]
      },
      "autoPowerOn": {
        "title": "Power on automatically when Brew is turned on",
        "type": "boolean",
        "default": true
      },
      "showSensors": {
        "title": "Show sensors (Needs Water, Pod Loaded, Lid)",
        "type": "boolean",
        "default": true
      },
      "showHotWaterSwitch": {
        "title": "Show a Hot Water switch (brews hot water with no pod)",
        "type": "boolean",
        "default": false
      },
      "hotWaterSize": {
        "title": "Hot water size (oz)",
        "type": "integer",
        "default": 8,
        "oneOf": [
          { "title": "4 oz", "enum": [4] },
          { "title": "6 oz", "enum": [6] },
          { "title": "8 oz", "enum": [8] },
          { "title": "10 oz", "enum": [10] },
          { "title": "12 oz", "enum": [12] }
        ]
      },
      "hotWaterTemperature": {
        "title": "Hot water temperature",
        "type": "string",
        "default": "MaxHot",
        "oneOf": [
          { "title": "Warm (187°F)", "enum": ["Warm"] },
          { "title": "Warmer (191°F)", "enum": ["Warmer"] },
          { "title": "Hot (194°F)", "enum": ["Hot"] },
          { "title": "Hotter (197°F)", "enum": ["Hotter"] },
          { "title": "Extra Hot (200°F)", "enum": ["XHot"] },
          { "title": "Max Hot (204°F)", "enum": ["MaxHot"] }
        ]
      },
      "subscriptionKey": {
        "title": "Advanced: Keurig API subscription key",
        "description": "Leave blank. Only change this if Keurig rotates the app key and a newer one is published.",
        "type": "string"
      },
      "apiUrl": {
        "title": "Advanced: Keurig API URL",
        "description": "Leave blank to use https://iot.keurig.com/connected-platform/",
        "type": "string"
      }
    }
  },
  "layout": [
    "name",
    "email",
    "password",
    "pollInterval",
    {
      "type": "fieldset",
      "title": "Brew defaults",
      "expandable": true,
      "expanded": true,
      "items": ["brewMode", "brewSize", "brewTemperature", "brewIntensity", "autoPowerOn"]
    },
    {
      "type": "fieldset",
      "title": "Extra accessories",
      "expandable": true,
      "expanded": false,
      "items": ["showSensors", "showHotWaterSwitch", "hotWaterSize", "hotWaterTemperature"]
    },
    {
      "type": "fieldset",
      "title": "Advanced",
      "expandable": true,
      "expanded": false,
      "items": ["subscriptionKey", "apiUrl"]
    }
  ]
}
